# Predictive-maintenance service environment — copy to .env and adapt.
# Defaults match local-dev docker-compose wiring.

# data-api gRPC endpoint (host:port)
DATA_API_GRPC_ADDR=data-api:8080

# NATS
NATS_HOST=nats
NATS_PORT=4222
NATS_USER=connector
NATS_PASSWORD=connector-pass

# VINs to monitor — comma- and/or whitespace-separated; empty = none.
# In the local stack this defaults to the VIN_POOL.
SCHEDULED_VINS=

# Per-VIN poll cadence (seconds)
POLL_INTERVAL_SECONDS=60

# Battery trend lookback (days)
BATTERY_WINDOW_DAYS=30

# structlog level: debug | info | warning | error
LOG_LEVEL=info
