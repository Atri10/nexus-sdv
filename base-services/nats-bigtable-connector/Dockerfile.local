FROM golang:1.25-alpine AS builder
ENV GOPROXY=https://goproxy.cn,direct
ENV GODEBUG=netdns=go


WORKDIR /app

# Install protobuf compiler
RUN apk add --no-cache protobuf protobuf-dev \
    && go install google.golang.org/protobuf/cmd/protoc-gen-go@latest

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy proto files from repo root
COPY ../../../proto ./proto/

# Generate Go protobuf code
RUN mkdir -p api/gen/telemetry \
    && protoc --proto_path=./proto \
        --go_out=api/gen/telemetry --go_opt=paths=source_relative \
        ./proto/telemetry.proto

# Copy generated protobuf code
COPY api/gen/telemetry ./api/gen/telemetry/

# Copy source code
COPY src/ ./src/

# Build
RUN CGO_ENABLED=0 go build -o /nats-bigtable-connector ./src

# Final stage
FROM alpine:3.20

RUN apk add --no-cache ca-certificates

COPY --from=builder /nats-bigtable-connector /nats-bigtable-connector

ENTRYPOINT ["/nats-bigtable-connector"]